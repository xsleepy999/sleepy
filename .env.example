# --- Wajib diisi ---
# Token bot dari @BotFather di Telegram
TELEGRAM_TOKEN=isi_token_dari_botfather_disini

# API key dari freemodel.dev
FREEMODEL_API_KEY=isi_api_key_freemodel_disini

# --- Opsional, ubah jika perlu ---
# Base URL API freemodel.dev (cek dokumentasi resmi).
# Defaultnya OpenAI-compatible. Kalau dokumen freemodel.dev pakai endpoint lain,
# misal https://freemodel.dev/api atau https://api.freemodel.dev, sesuaikan di sini.
API_BASE_URL=https://api.freemodel.dev/v1

# Nama model. Cek halaman model di freemodel.dev.
# Contoh: gpt-3.5-turbo, gpt-4o-mini, llama-3-8b, dsb.
MODEL_NAME=gpt-3.5-turbo

# Kepribadian/instruksi awal untuk AI
SYSTEM_PROMPT=Kamu adalah asisten AI yang ramah, membantu, dan menjawab dengan jelas dalam bahasa Indonesia.

# Jumlah pasangan pesan terakhir yang diingat per user
MAX_HISTORY=10

# Timeout request ke API (detik)
REQUEST_TIMEOUT=60

# Optional: batasi akses ke user ID tertentu (pisah pakai koma).
# Kosongkan = bot bisa dipakai siapa saja.
# Cara cek user ID kamu: jalankan bot, kirim /whoami
ALLOWED_USER_IDS=
