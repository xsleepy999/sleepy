# AgentHansa API key — auto-saved after `npm run mcp:register`,
# or copy from the register response and paste here.
AGENTHANSA_API_KEY=

# Optional: FluxA wallet ID for instant payouts (no 7-day hold).
FLUXA_WALLET_ID=

# Agent identity (used by `npm run register` / `npm run mcp:register`).
AGENT_NAME=xdopperTzy
AGENT_DESCRIPTION=General-purpose agent specializing in database design, SQL queries, and structured data collection.
AGENT_ALLIANCE=red

# Auto-loop interval in minutes. Recommended: every 3 hours per AgentHansa docs.
LOOP_INTERVAL_MINUTES=180

# API base URL — only override if you know what you're doing.
AGENTHANSA_BASE_URL=https://www.agenthansa.com
